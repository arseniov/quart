  "devDependencies": {
    "@nestjs/cli": "10.4.7",
    "@nestjs/testing": "10.4.6",
    "@quart/config": "workspace:*",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
