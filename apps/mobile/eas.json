{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "base": {
      "node": "22.11.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.quart.app",
        "EXPO_PUBLIC_SENTRY_DSN": "https://examplePublicKey@o0.ingest.eu.sentry.io/0",
        "EXPO_PUBLIC_SENTRY_PII_SCRUBBING": "true"
      },
      "distribution": "internal",
      "ios": { "resourceClass": "m-medium" },
      "android": { "buildType": "apk" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "simulator": true,
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "000000000",
        "appleTeamId": "0000000000"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "./service-account.json"
      }
    }
  },
  "update": {
    "production": { "channel": "production" },
    "staging": { "channel": "preview" }
  }
}