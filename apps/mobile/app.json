{
  "expo": {
    "name": "Quart",
    "slug": "quart",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.quart.mobile"
    },
    "android": {
      "package": "app.quart.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FF6B35"
      }
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-router",
      "expo-secure-store",
      "sentry-expo"
    ]
  }
}
