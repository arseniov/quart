{
  "name": "@quart/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=forks",
    "test:integration": "vitest run --pool=forks src/tests/pii.test.ts",
    "lint": "eslint src",
    "generate-types": "tsx scripts/generate-types.ts"
  },
  "dependencies": {
    "kysely": "0.27.4",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@quart/config": "workspace:*",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "eslint": "9.17.0",
    "kysely-codegen": "^0.20.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
