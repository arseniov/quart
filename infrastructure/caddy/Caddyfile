# Caddy runs behind Cloudflare Tunnel (HTTPS terminated at the edge).
# Caddy listens on :8080 (HTTP) — TLS is provided by Cloudflare.
# Only Cloudflare IPs are allowed; direct internet access is rejected.

# Cloudflare IP ranges — refresh quarterly from https://www.cloudflare.com/ips/
# Last reviewed: 2026-09
(common_ip_gate) {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @not_cloudflare "Direct access not allowed" 403
}

(common_headers) {
	header {
		# HSTS preload: register at https://hstspreload.org after first prod deploy.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		# CSP set per-app (API vs admin) in their respective reverse_proxy blocks.
	}
	# Pass CF-Connecting-IP through unchanged; Caddy trusts Cloudflare's header.
	header CF-Connecting-IP {remote.host}
	header -Server
}

:8080 {
	import common_ip_gate
	import common_headers
	reverse_proxy api:3000 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}
}

# admin.quart.app handled by SvelteKit itself on a separate service.
